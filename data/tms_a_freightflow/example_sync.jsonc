// ============================================================================
// TMS A — "FreightFlow" — sync snapshot 2026-07-06 06:00
// ============================================================================
// Every TMS is synced every 6 hours (00:00, 06:00, 12:00, 18:00). Each sync
// produces one self-contained file like this one, named with the sync time.
// A sync contains 1–3 loads: every load created OR changed since the last
// sync (status moved, amounts updated, details corrected). If a load appears
// in a later file, the later file is the newer truth for that load.
//
// Style: modern REST API. Nested JSON, camelCase, everything about a load in
// one object. US units (lbs, miles). Timestamps are ISO-8601 with offset.
// ============================================================================
{
  "syncedAt": "2026-07-06T06:00:00-05:00",
  "loads": [
    {
      "shipmentId": 127472397,          // FreightFlow's own ID — unique and stable per load
      "status": "Booking",              // Full status vocabulary:
                                        //   "Quoting"      — customer asked for a price
                                        //   "Booking"      — broker searching for a carrier
                                        //   "Dispatched"   — carrier booked, truck on the way to pickup
                                        //   "At Shipper"   — truck at the pickup location
                                        //   "En Route"     — driving to the destination
                                        //   "At Receiver"  — truck at the delivery location
                                        //   "Delivered"    — freight delivered
                                        //   "Completed"    — paperwork and payments closed
      "mileage": 242.1,                 // driving distance, MILES
      "totalSell": 1450.0,              // what the customer pays the broker, USD
      "totalBuy": null,                 // what the broker pays the carrier, USD.
                                        // null until a carrier is booked; can still be
                                        // adjusted afterwards (detention, layover, corrections)
      "customer": {
        "customerId": 889264,
        "name": "Lone Star Beverages"
      },
      "carrier": null,                  // null while status is "Quoting" / "Booking"
      "equipment": "53 ft Van | Dry",   // free-text trailer description, e.g.
                                        //   "53 ft Van | Dry", "53 ft Van | Reefer", "48 ft Flatbed"
      "weightTotal": 24000.0,           // POUNDS
      "stops": [                        // always ordered; first = pickup, last = delivery.
        {
          "stopType": "First Pickup",
          "city": "GRAND PRAIRIE",      // cities are UPPERCASE in FreightFlow
          "state": "TX",
          "zipCode": "75050",
          "estimatedReadyDateTime": "2026-07-07T08:00:00-05:00",   // window open
          "estimatedCloseDateTime": "2026-07-07T16:00:00-05:00",   // window close
          "actualDepartureDateTime": null   // set once the truck leaves the stop
        },
        {
          "stopType": "Last Drop",
          "city": "KATY",
          "state": "TX",
          "zipCode": "77449",
          "estimatedReadyDateTime": "2026-07-08T08:00:00-05:00",
          "estimatedCloseDateTime": "2026-07-08T16:00:00-05:00",
          "actualDepartureDateTime": null
        }
      ],
      "createdDate": "2026-07-06T04:12:44-05:00",
      "lastModifiedDate": "2026-07-06T04:12:44-05:00"   // bumped on ANY change, incl. corrections
    }
  ]
}
