  "info": {
    "title": "Carrier Pool API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/loads": {
      "get": {
        "description": "List only caller-tenant current load projections, ACTIVE by default.",
        "operationId": "list_loads_api_v1_loads_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/LoadStatus",
              "default": "ACTIVE"
            }
          },
          {
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LoadResponse"
                  },
                  "title": "Response List Loads Api V1 Loads Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Loads",
        "tags": ["loads"]
      }
    },
    "/api/v1/loads/{load_id}": {
      "get": {
        "description": "Return current tenant-owned load; hide cross-tenant existence.",
        "operationId": "get_load_api_v1_loads__load_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "load_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Load Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Load",
        "tags": ["loads"]
      }
    },
    "/api/v1/loads/{load_id}/decision": {
      "get": {
        "description": "Return latest persisted decision for current ACTIVE input, never recompute implicitly.",
        "operationId": "get_decision_api_v1_loads__load_id__decision_get",
        "parameters": [
          {
            "in": "path",
            "name": "load_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Load Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Decision",
        "tags": ["decisions"]
      }
    },
    "/api/v1/tenants": {
      "get": {
        "description": "Return safe public fictional-broker fields for demo selection.",
        "operationId": "list_tenants_api_v1_tenants_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TenantResponse"
                  },
